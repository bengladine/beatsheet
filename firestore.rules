rules_version = '2';
// Drumsheet: every signed-in user can only read and write their own grooves.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/grooves/{grooveId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'q', 'saved'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.q is string && request.resource.data.q.size() <= 20000
        && request.resource.data.saved is int;
    }
    // Teacher waitlist (teachers.html): anyone may add themselves; nobody can read the list from the web
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'students', 'note', 'created'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.students is string && request.resource.data.students.size() <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.created == request.time;
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
