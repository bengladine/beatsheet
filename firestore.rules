rules_version = '2';
// Drumsheet: every signed-in user can only read and write their own grooves.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/grooves/{grooveId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'q', 'saved'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.q is string && request.resource.data.q.size() <= 20000
        && request.resource.data.saved is int;
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
